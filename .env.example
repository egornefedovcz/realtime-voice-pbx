# ---------- core ----------
OPENAI_API_KEY=sk-...
# yeastar | asterisk-ari | asterisk-audiosocket | twilio  (comma-separated for several)
TRANSPORT=asterisk-audiosocket
# Module exporting your agent (defineAgent). Default: examples/pottery-studio
AGENT=./examples/pottery-studio
PORT=8080
REALTIME_MODEL=gpt-realtime
VOICE=ash
VOICE_SPEED=1.1
TRANSCRIBE_MODEL=gpt-4o-transcribe
# Language hint for caller transcripts, e.g. cs, de, en. Empty = auto.
TRANSCRIBE_LANGUAGE=
VAD_THRESHOLD=0.5
VAD_PREFIX_MS=300
VAD_SILENCE_MS=900
MAX_CALL_SECONDS=900
SUMMARY_MODEL=gpt-4o

# ---------- example agent ----------
KNOWLEDGE_FILE=
EXAMPLE_DATA_FILE=
BUSINESS_TIMEZONE=America/New_York

# ---------- transport: yeastar ----------
YEASTAR_SECRET=
YEASTAR_PATH=/yeastar-stream

# ---------- transport: asterisk-ari ----------
ARI_URL=http://127.0.0.1:8088
ARI_USER=voicebot
ARI_PASSWORD=
ARI_APP=voicebot
RTP_HOST=127.0.0.1
RTP_PORT_MIN=40000
RTP_PORT_MAX=40100
# Live transfer targets: rota API, or a static list, plus an optional fallback number
SHIFTS_URL=
SHIFTS_TOKEN=
STAFF_DIAL_TARGETS=
FALLBACK_NUMBER=
RING_TIMEOUT=30
MOH_CLASS=default
STAFF_CONTEXT=staff-ring
DEFAULT_COUNTRY_CODE=
NATIONAL_NUMBER_LENGTH=9

# ---------- transport: asterisk-audiosocket ----------
AUDIOSOCKET_HOST=127.0.0.1
AUDIOSOCKET_PORT=9092
AUDIOSOCKET_HTTP_PORT=9093

# ---------- SIP trunk (used by the render scripts, not by Node) ----------
SIP_SERVER=sip.example.net
SIP_USER=
SIP_PASSWORD=
SIP_TRANSPORT=transport-udp
SIP_PROVIDER_CIDR=203.0.113.0/24

# ---------- escalation (any combination; none = log to console) ----------
ESCALATION_WEBHOOK_URL=
ESCALATION_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ESCALATION_EMAIL_FROM=
ESCALATION_EMAIL_TO=
CHATWOOT_URL=
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=
CHATWOOT_DEDUPE_INBOX_IDS=

# ---------- tools/call-transcripts ----------
RECORDINGS_DIR=/var/spool/asterisk/monitor
TRANSCRIPTS_DIR=
RETENTION_DAYS=90
TRANSCRIPTION_MODEL=gpt-4o-transcribe
SUMMARY_LANGUAGE=English
BUSINESS_CONTEXT=a pottery studio offering classes
DIGEST_WEBHOOK_URL=
